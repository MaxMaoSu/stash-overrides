#SUBSCRIBED https://raw.githubusercontent.com/MaxMaoSu/stash-overrides/main/spotify/Spotify.stoverride
#!name = Spotify 解锁
#!desc = 适配 Spotify Nebula 接口，解锁 Premium，附实验性列表过滤
name: Spotify 解锁
desc: 解锁 Premium 账号属性、实验性列表过滤
icon: 'https://raw.githubusercontent.com/MaxMaoSu/stash-overrides/main/spotify/spotify-icon.png'

rules:
  # 必须用域级宽匹配。regional 主机是 guc3-spclient.spotify.com，
  # DOMAIN-SUFFIX,spclient.spotify.com 因标签边界（- 不是 .）匹配不到它，
  # 而 QUIC 一旦漏掉就完全绕过 MITM，且没有任何日志可见。
  # 音频 CDN 在 scdn.co / akamaized.net / spotifycdn.com，不以 spotify.com 结尾，
  # 这条规则碰不到它们。
  - AND,((DOMAIN-SUFFIX,spotify.com),(PROTOCOL,QUIC)),REJECT-DROP
  # 遥测/网络探测端点：REJECT 即可，REJECT-DROP 直接断连会让客户端反复重试
  - DOMAIN,aet.spotify.com,REJECT

http:
  mitm:
    # 只解密 spclient 系主机。用 *.spotify.com 会把 api/login5/apresolve 等
    # 无关域名一起解密，既增加开销又可能影响其它功能。
    # 三个模式都保留：*.wg 与 *-spclient.wg 是不同标签深度。
    - 'spclient.wg.spotify.com'
    - '*spclient.spotify.com'
    - '*-spclient.wg.spotify.com'
  script:
    # 第一步：删掉条件请求头。服务器命中 ETag 会返回 304，而 304 没有响应体，
    # spotify-proto 拿到空 body 只能 passthrough，账号属性永远改不掉。
    # Stash 没有 header-rewrite 键，只能用 request 脚本改 $request.headers。
    - match: '^https:\/\/(?:[A-Za-z0-9-]+-)?spclient(?:\.wg)?\.spotify\.com(?::443)?\/(?:nebula\/v1\/configuration\/attributes|bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize)\/?(?:\?.*)?$'
      name: spotify-strip304
      type: request
      timeout: 5
    # 首页脚本按 protobuf 解析；Mac 端日志出现过 "unrecognized response, passed through"，
    # 是否真的过滤以 script-logs 里的 "removed ... section(s)" 为准。
    - match: '^https:\/\/(?:[A-Za-z0-9-]+-)?spclient(?:\.wg)?\.spotify\.com(?::443)?\/casita\/v1\/home\/default\/?(?:\?.*)?$'
      name: spotify-home
      type: response
      require-body: true
      binary-mode: true
      timeout: 10
    # browse / scroll 保留尾部可选路径与查询串，别把 $ 卡死在 /browse 上
    - match: '^https:\/\/(?:[A-Za-z0-9-]+-)?spclient(?:\.wg)?\.spotify\.com(?::443)?\/browsita\/v[0-9]+\/browse(?:\/[^?]*)?(?:\?.*)?$'
      name: spotify-search
      type: response
      require-body: true
      binary-mode: true
      timeout: 10
    - match: '^https:\/\/(?:[A-Za-z0-9-]+-)?spclient(?:\.wg)?\.spotify\.com(?::443)?\/scrollsita\/v[0-9]+\/scroll\/spotify(?:\/[^?]*)?(?:\?.*)?$'
      name: spotify-scroll
      type: response
      require-body: true
      binary-mode: true
      timeout: 10
    # spotify-proto 内嵌 406KB protobuf schema，WebKit 引擎默认 10 秒跑不完，
    # 会报 script execution timed out 且只在 Core/logs 里可见。必须给足 30 秒。
    # 注意不要匹配 remote-config-resolver：桌面版该接口返回 JSON，
    # proto 按 protobuf 解码会抛 invalid wire type，异常会重置 WebKit 引擎，
    # 连带让同期 nebula 的脚本跑不掉。
    - match: '^https:\/\/(?:[A-Za-z0-9-]+-)?spclient(?:\.wg)?\.spotify\.com(?::443)?\/(?:bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize|nebula\/v1\/configuration\/attributes)\/?(?:\?.*)?$'
      name: spotify-proto
      type: response
      require-body: true
      binary-mode: true
      max-size: 0
      timeout: 30
    - match: '^https:\/\/(?:[A-Za-z0-9-]+-)?spclient(?:\.wg)?\.spotify\.com(?::443)?\/(?:artistview\/v1\/artist|album-entity-view\/v2\/album)\/'
      name: spotify-json
      type: request
      timeout: 10

# 注意：这里没有 url-rewrite / header-rewrite / mock 段。
# 实测 Stash 4.3.5（macOS）在**已被 MITM 的域名**上，这三组键全部不生效：
#   - url-rewrite 的 reject / reject-200 / 302 对 gabo-receiver-service 无效
#   - mock 指定 status-code 599 对 nebula 无效（仍返回 401）
#   - header-rewrite 的 request-add 未注入
# 对照组：同一文件里的 http.mitm 与 http.script 均正常工作，重载也确实生效。
# 因此官方文档里那套 rewrite 语法只能写在主配置，覆写里用不了；
# 要改请求 / 去请求头只能走脚本（见 spotify-strip304-v2.js）。

# Reukix 的四个脚本锁定到 commit，避免上游改动导致行为漂移。
# strip304 走本仓库 main；json 锁定到 app2smile 的 commit。改动后需等 interval 到期或重载。
# 升级方式：改 SHA → 重载 → 确认 script-logs 尾部时间戳更新且无 passthrough / timed out。
script-providers:
  spotify-strip304:
    url: https://raw.githubusercontent.com/MaxMaoSu/stash-overrides/main/spotify/spotify-strip304-v2.js
    interval: 86400
  spotify-home:
    url: https://raw.githubusercontent.com/Reukix/ukix/406b5f63dd461d551f1b03098d374bae5c7b1296/js/Spotify-home.js
    interval: 86400
  spotify-search:
    url: https://raw.githubusercontent.com/Reukix/ukix/406b5f63dd461d551f1b03098d374bae5c7b1296/js/Spotify-search.js
    interval: 86400
  spotify-scroll:
    url: https://raw.githubusercontent.com/Reukix/ukix/406b5f63dd461d551f1b03098d374bae5c7b1296/js/Spotify-scroll.js
    interval: 86400
  spotify-proto:
    url: https://raw.githubusercontent.com/Reukix/ukix/406b5f63dd461d551f1b03098d374bae5c7b1296/js/Spotify-proto.js
    interval: 86400
  spotify-json:
    url: https://raw.githubusercontent.com/app2smile/rules/df6366a7024e0b3f0aa3510c5b791eea6f3cba89/js/spotify-json.js
    interval: 86400
