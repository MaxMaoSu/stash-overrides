#SUBSCRIBED https://raw.githubusercontent.com/MaxMaoSu/stash-overrides/main/Spotify.stoverride
#!name = Spotify 解锁
#!desc = 适配 Spotify 9.1.98 的 Nebula / Remote Config 接口及 Casita 首页去广告
name: Spotify 解锁
desc: 解锁 Premium 账号属性、去广告、禁止 QUIC 绕过 MITM
rules:
  # Spotify 9.1.98 起用 HTTP/3 直连 spclient，不掐 QUIC 就完全绕过 MITM
  - AND,((DOMAIN-SUFFIX,spotify.com),(PROTOCOL,QUIC)),REJECT-DROP
  - DOMAIN,aet.spotify.com,REJECT-DROP
http:
  mitm:
    - 'spclient.wg.spotify.com'
    # 必须用 *.spotify.com：实际域名是 guc3-spclient.spotify.com，
    # '*spclient.spotify.com' 这种标签内通配在 Stash 上不匹配
    - '*.spotify.com'
  script:
    # 删掉 If-None-Match / If-Modified-Since，否则服务器返回 304 无 body，
    # spotify-proto 拿到空响应只能 passthrough
    - match: '^https:\/\/(?:[A-Za-z0-9-]+-)?spclient(?:\.wg)?\.spotify\.com(?::443)?\/(?:nebula\/v1\/configuration\/attributes|remote-config-resolver\/v3\/configuration|bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize)'
      name: spotify-strip304
      type: request
      timeout: 5
    - match: '^https:\/\/(?:[A-Za-z0-9-]+-)?spclient(?:\.wg)?\.spotify\.com(?::443)?\/casita\/v1\/home\/default\/?(\?[^#]*)?$'
      name: spotify-home
      type: response
      require-body: true
      binary-mode: true
      timeout: 30
    - match: '^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/browsita\/v.\/browse'
      name: spotify-search
      type: response
      require-body: true
      binary-mode: true
      timeout: 30
    - match: '^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/scrollsita\/v.\/scroll\/spotify'
      name: spotify-scroll
      type: response
      require-body: true
      binary-mode: true
      timeout: 30
    # 406KB 内嵌 protobuf schema，WebKit 引擎默认 10s 跑不完会 timed out，
    # timeout 必须给到 30
    - match: '^https:\/\/(?:[A-Za-z0-9-]+-)?spclient(?:\.wg)?\.spotify\.com(?::443)?\/(?:bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize|nebula\/v1\/configuration\/attributes|remote-config-resolver\/v3\/configuration)\/?(\?[^#]*)?$'
      name: spotify-proto
      type: response
      require-body: true
      binary-mode: true
      timeout: 30
    - match: '^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/(artistview\/v1\/artist|album-entity-view\/v2\/album)\/'
      name: spotify-json
      type: request
      timeout: 30
  rewrite:
    - ^https?:\/\/(spclient\.wg|.*-spclient)\.spotify\.com(:443)?\/pendragon - reject-200
    - ^https?:\/\/.*-spclient\.spotify\.com(:443)?\/pam-view-service\/ - reject-200
    - ^https?:\/\/.*37i9dQZF1EYkqdzj48dyYq - reject-200
script-providers:
  spotify-strip304:
    url: https://raw.githubusercontent.com/MaxMaoSu/stash-overrides/main/spotify-strip304.js
    interval: 86400
  # 以下四个来自 Reukix/ukix，2026-11-11 适配 Spotify 9.1.98
  spotify-home:
    url: https://raw.githubusercontent.com/Reukix/ukix/refs/heads/main/js/Spotify-home.js
    interval: 86400
  spotify-search:
    url: https://raw.githubusercontent.com/Reukix/ukix/refs/heads/main/js/Spotify-search.js
    interval: 86400
  spotify-scroll:
    url: https://raw.githubusercontent.com/Reukix/ukix/refs/heads/main/js/Spotify-scroll.js
    interval: 86400
  spotify-proto:
    url: https://raw.githubusercontent.com/Reukix/ukix/refs/heads/main/js/Spotify-proto.js
    interval: 86400
  spotify-json:
    url: https://raw.githubusercontent.com/app2smile/rules/master/js/spotify-json.js
    interval: 86400
