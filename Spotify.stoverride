#SUBSCRIBED https://raw.githubusercontent.com/MaxMaoSu/stash-overrides/main/Spotify.stoverride
#!name = Spotify 解锁
#!desc = 适配 Spotify 9.1.98 的 Nebula / Remote Config 接口及 Casita 首页去广告
name: Spotify 解锁
desc: 解锁 Premium 账号属性、去广告

rules:
  # 只对需要 MITM 的 spclient 域名拦截 QUIC。
  # 不要写成 DOMAIN-SUFFIX,spotify.com —— 会连带把音频 CDN 和其它 Spotify 服务的
  # HTTP/3 也降级到 TCP，白白增加延迟。
  - AND,((DOMAIN-SUFFIX,spclient.spotify.com),(PROTOCOL,QUIC)),REJECT-DROP
  - AND,((DOMAIN,spclient.wg.spotify.com),(PROTOCOL,QUIC)),REJECT-DROP
  # 遥测/网络探测端点：REJECT 即可，REJECT-DROP 直接断连会让客户端反复重试
  - DOMAIN,aet.spotify.com,REJECT

http:
  mitm:
    # 只解密 spclient。用 *.spotify.com 会把 api/login5/apresolve 等无关域名一起解密，
    # 既增加开销又可能影响其它功能。
    # Stash 支持中缀通配：*spclient.spotify.com 能匹配 guc3-spclient.spotify.com。
    - 'spclient.wg.spotify.com'
    - '*spclient.spotify.com'
  script:
    # 第一步：删掉条件请求头。服务器命中 ETag 会返回 304，而 304 没有响应体，
    # spotify-proto 拿到空 body 只能 passthrough，账号属性永远改不掉。
    # Stash 没有 header-rewrite 键，只能用 request 脚本改 $request.headers。
    - match: '^https:\/\/(?:[A-Za-z0-9-]+-)?spclient(?:\.wg)?\.spotify\.com(?::443)?\/(?:nebula\/v1\/configuration\/attributes|remote-config-resolver\/v3\/configuration|bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize)(?:\?.*)?$'
      name: spotify-strip304
      type: request
      timeout: 5
    - match: '^https:\/\/(?:[A-Za-z0-9-]+-)?spclient(?:\.wg)?\.spotify\.com(?::443)?\/casita\/v1\/home\/default\/?(?:\?.*)?$'
      name: spotify-home
      type: response
      require-body: true
      binary-mode: true
      timeout: 10
    - match: '^https:\/\/(?:[A-Za-z0-9-]+-)?spclient(?:\.wg)?\.spotify\.com(?::443)?\/browsita\/v[0-9]+\/browse(?:\?.*)?$'
      name: spotify-search
      type: response
      require-body: true
      binary-mode: true
      timeout: 10
    - match: '^https:\/\/(?:[A-Za-z0-9-]+-)?spclient(?:\.wg)?\.spotify\.com(?::443)?\/scrollsita\/v[0-9]+\/scroll\/spotify(?:\?.*)?$'
      name: spotify-scroll
      type: response
      require-body: true
      binary-mode: true
      timeout: 10
    # spotify-proto 内嵌 406KB protobuf schema，WebKit 引擎默认 10 秒跑不完，
    # 会报 script execution timed out 且只在 Core/logs 里可见。必须给足 30 秒。
    - match: '^https:\/\/(?:[A-Za-z0-9-]+-)?spclient(?:\.wg)?\.spotify\.com(?::443)?\/(?:bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize|nebula\/v1\/configuration\/attributes|remote-config-resolver\/v3\/configuration)\/?(?:\?.*)?$'
      name: spotify-proto
      type: response
      require-body: true
      binary-mode: true
      timeout: 30
    - match: '^https:\/\/(?:[A-Za-z0-9-]+-)?spclient(?:\.wg)?\.spotify\.com(?::443)?\/(?:artistview\/v1\/artist|album-entity-view\/v2\/album)\/'
      name: spotify-json
      type: request
      timeout: 10
  rewrite:
    - ^https?:\/\/(spclient\.wg|.*-spclient)\.spotify\.com(:443)?\/pendragon - reject-200
    - ^https?:\/\/.*-spclient\.spotify\.com(:443)?\/pam-view-service\/ - reject-200
    - ^https?:\/\/.*37i9dQZF1EYkqdzj48dyYq - reject-200

# 脚本锁定到具体 commit，避免上游改动导致行为漂移。
# 升级方式：改这里的 SHA，重新拉取后验证 script-logs 里没有 passthrough / timed out。
script-providers:
  spotify-strip304:
    url: https://raw.githubusercontent.com/MaxMaoSu/stash-overrides/main/spotify-strip304.js
    interval: 86400
  spotify-home:
    url: https://raw.githubusercontent.com/Reukix/ukix/406b5f63dd461d551f1b03098d374bae5c7b1296/js/Spotify-home.js
    interval: 86400
  spotify-search:
    url: https://raw.githubusercontent.com/Reukix/ukix/406b5f63dd461d551f1b03098d374bae5c7b1296/js/Spotify-search.js
    interval: 86400
  spotify-scroll:
    url: https://raw.githubusercontent.com/Reukix/ukix/406b5f63dd461d551f1b03098d374bae5c7b1296/js/Spotify-scroll.js
    interval: 86400
  spotify-proto:
    url: https://raw.githubusercontent.com/Reukix/ukix/406b5f63dd461d551f1b03098d374bae5c7b1296/js/Spotify-proto.js
    interval: 86400
  spotify-json:
    url: https://raw.githubusercontent.com/app2smile/rules/master/js/spotify-json.js
    interval: 86400
